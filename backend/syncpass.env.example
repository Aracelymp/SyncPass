# Variables de entorno para ejecutar SyncPass backend en produccion.
# Copiar este archivo a syncpass.env, completar los valores reales y NO versionarlo.

# Puerto del servidor (opcional, por defecto 8080)
SERVER_PORT=8080

# Base de datos PostgreSQL (produccion / Supabase)
# Ejemplo de DATABASE_URL para Supabase transaction pooler:
#   jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?prepareThreshold=0
DATABASE_URL=jdbc:postgresql://<HOST>:<PUERTO>/<BASE_DE_DATOS>?prepareThreshold=0
DB_USER=<USUARIO_POSTGRES>
DB_PASSWORD=<CONTRASENA_POSTGRES>

# Clave para firmar tokens JWT.
# Requisitos:
# - Obligatoria en produccion.
# - Minimo 32 bytes (256 bits).
# - Se recomiendan 64 caracteres aleatorios.
# Ejemplo de generacion en Linux:
#   openssl rand -base64 64
JWT_SECRET=<clave-segura-de-al-menos-64-caracteres-aleatorios>

# Tiempo de expiracion del token JWT en milisegundos (opcional)
JWT_EXPIRATION_MS=604800000

# Origenes permitidos para CORS, separados por comas.
# Ejemplo: https://app.syncpass.example.com,https://admin.syncpass.example.com
CORS_ALLOWED_ORIGINS=<origenes-permitidos>

# Configuracion de AWS Cognito (us-east-1)
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/<USER_POOL_ID>
# App Client ID autorizados, separados por comas.
# Orden: SyncPass-Web, SyncPass-Android
COGNITO_CLIENT_IDS=33tgu296dc5itbh3te23rndi2q,36tb2beisuo9gd5o3bekt3e7ac
COGNITO_REGION=us-east-1
COGNITO_JWKS_URI=https://cognito-idp.us-east-1.amazonaws.com/<USER_POOL_ID>/.well-known/jwks.json
